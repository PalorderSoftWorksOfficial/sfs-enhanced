<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AutomaticallyUseReferenceAssemblyPackages>true</AutomaticallyUseReferenceAssemblyPackages>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>SFSEnhanced.Mod</RootNamespace>
    <AssemblyName>SFSEnhanced</AssemblyName>
    <!-- Drop build output into Mods/SFSEnhanced/SFSEnhanced.dll (game's native ModLoader). -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\SFSEnhanced.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="AscensionGameDev.Lidgren.Network" Version="1.8.0.13" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" />
  </ItemGroup>

  <!--
    Game assemblies live in repo-root Dependencies/ (copied from
    Spaceflight Simulator_Data/Managed/). ModLoader is compiled INTO
    Assembly-CSharp â€” no separate ModLoader.dll or Harmony required.
  -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\Dependencies\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\Dependencies\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\Dependencies\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http" />
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\Dependencies\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.Physics2DModule">
      <HintPath>..\Dependencies\UnityEngine.Physics2DModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>..\Dependencies\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\Dependencies\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\Dependencies\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="mod.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\tools\BuildSfsPack\BuildSfsPack.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <PropertyGroup>
    <SfsPackVersion Condition="'$(SfsPackVersion)' == ''">1.0.0</SfsPackVersion>
    <SfsPackOutput Condition="'$(SfsPackOutput)' == ''">$(MSBuildThisFileDirectory)..\artifacts\SFSEnhanced-Mod-$(SfsPackVersion).pack</SfsPackOutput>
  </PropertyGroup>

  <Target Name="BuildSfsPack" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <SfsPackPayloadDir Condition="$(OutputPath.EndsWith('\'))">$(OutputPath.Substring(0, $([MSBuild]::Add($(OutputPath.Length), -1))))</SfsPackPayloadDir>
      <SfsPackPayloadDir Condition="'$(SfsPackPayloadDir)' == ''">$(OutputPath)</SfsPackPayloadDir>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(MSBuildThisFileDirectory)..\tools\BuildSfsPack\bin\$(Configuration)\net8.0\BuildSfsPack.dll&quot; --out &quot;$(SfsPackOutput)&quot; --id sfs-enhanced --name &quot;SFS Enhanced&quot; --version $(SfsPackVersion) --description &quot;SFS Enhanced multiplayer mod: secure UDP multiplayer, shared worlds, friends, and chat.&quot; --min-sfs-enhanced 0.1.1 --dir &quot;$(SfsPackPayloadDir)&quot; &quot;Mods/SFSEnhanced&quot;" />
  </Target>

</Project>
