<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Clear machine-wide offline feeds that 404 on this machine (VS Offline Packages). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
